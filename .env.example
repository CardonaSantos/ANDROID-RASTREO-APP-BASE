# Configuración de MARCAS-GT-SERVER; copiar como .env
# development admite HTTP LAN. preview/production requieren HTTPS.
EXPO_PUBLIC_APP_ENV=development

# Emulador Android hacia NestJS local (puerto por defecto: 4000)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# En dispositivo físico reemplazar por IP LAN del PC:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
# En Railway reemplazar por el dominio HTTPS real del backend.
#
# El backend actual solo envía eventos de tracking a ADMIN.
# Activa el socket cuando una feature de esta app lo necesite:
EXPO_PUBLIC_REALTIME_ENABLED=false
# Al activar: vacío => misma URL de EXPO_PUBLIC_API_URL.
# No utilizar localhost desde un emulador, salvo redirección ADB.
EXPO_PUBLIC_REALTIME_URL=
